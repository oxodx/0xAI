{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"version": "${version}",
	"name": "${mod_name}",
	"description": "${description}",
	"authors": [
		"${mod_author}"
	],
	"contact": {
		"sources": "https://github.com/oxodx/oxai",
		"issues": "${issues}"
	},
	"license": "${license}",
	"icon": "assets/oxai/icon.png",
	"environment": "*",
	"entrypoints": {
		"client": [
			{
				"value": "nl.oxod.oxai.OxAI"
			}
		],
		"modmenu": [
			{
				"value": "nl.oxod.oxai.OxAIModMenuApi"
			}
		]
	},
	"mixins": [
		"${mod_id}.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${fabric_loader_version}",
		"fabric-command-api-v2": ">=${fabric_version}",
		"fabric-lifecycle-events-v1": ">=${fabric_version}",
		"fabric-resource-loader-v0": ">=${fabric_version}",
		"fabric-convention-tags-v2": ">=${fabric_version}",
		"minecraft": "~${minecraft_version}",
		"java": ">=${java_version}",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}
